MONGO_URI=mongodb://127.0.0.1:27017/mern-ecommerce
PORT=5000
JWT_SECRET=replace_with_a_secret
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
AI_API_KEY=replace_with_ai_key
FRONTEND_URL=http://localhost:5173/auth/login

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM=your_email@example.com
ADMIN_EMAIL=admin@example.com

TWILIO_ACCOUNT_SID=replace_with_twilio_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_token
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+911234567890
DEFAULT_USER_WHATSAPP_TO=whatsapp:+911234567890
